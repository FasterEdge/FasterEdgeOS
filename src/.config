# 首次构建 FasterEdgeOS 前，建议先阅读 README 文件。

###################################################
#                                                 #
#  以下为主源码包（source bundles）下载配置       #
#                                                 #
###################################################

# Linux 内核源码包下载地址（最新版本见 https://kernel.org）：
KERNEL_SOURCE_URL=https://kernel.org/pub/linux/kernel/v5.x/linux-5.18.3.tar.xz

# GNU C 库源码包下载地址（最新版本见 https://gnu.org/software/libc）：
GLIBC_SOURCE_URL=https://ftp.gnu.org/gnu/glibc/glibc-2.35.tar.bz2

# Busybox 源码包下载地址（最新版本见 https://busybox.net）：
BUSYBOX_SOURCE_URL=https://busybox.net/downloads/busybox-1.34.1.tar.bz2

# Syslinux 源码包下载地址：
#
#   https://syslinux.org （官方网站）
#
#   https://kernel.org/pub/linux/utils/boot/syslinux
#
SYSLINUX_SOURCE_URL=https://kernel.org/pub/linux/utils/boot/syslinux/syslinux-6.03.tar.xz

# systemd-boot 源码包下载地址：
#
#   https://github.com/ivandavidov/systemd-boot
#
SYSTEMD-BOOT_SOURCE_URL=https://github.com/ivandavidov/systemd-boot/releases/download/systemd-boot_26-May-2018/systemd-boot_26-May-2018.tar.xz

####################################################
#                                                  #
#  以下为系统配置属性                              #
#                                                  #
####################################################

# 固件兼容性，决定生成的 ISO 镜像可在哪些系统上启动。
#
#  bios - 生成的 ISO 镜像兼容传统 BIOS 系统。默认选项，无需 root 权限。
#
#  uefi - 生成的 ISO 镜像兼容 UEFI 系统。该选项需要 root 权限。
#
#  both - 生成的 ISO 镜像同时兼容传统 BIOS 与现代 UEFI 系统。该选项需要 root 权限。
#
FIRMWARE_TYPE=bios

# 构建内核时使用预定义的 '.config' 文件。启用后会覆盖 'xx_build_kernel.sh'
# 中的配置生成逻辑，构建过程改用本参数指定的配置文件。配置文件放置于：
#
# minimal_config/kernel.config
#
USE_PREDEFINED_KERNEL_CONFIG=false

# 构建内核模块，并使其在 overlayfs/rootfs 的 /lib/modules 目录中可用。
# 模块可通过 'insmod' 加载，以支持额外外设与软件设备。
# 注意：加载 overlayfs 所需的核心驱动必须编译进内核，否则 overlayfs 可能无法加载。
BUILD_KERNEL_MODULES=false

# 构建 Busybox 时使用预定义的 '.config' 文件。启用后会覆盖
# 'xx_build_busybox.sh' 中的配置生成逻辑，构建过程改用本参数指定的配置文件。
# 配置文件放置于：
#
# minimal_config/busybox.config
#
USE_PREDEFINED_BUSYBOX_CONFIG=false

# overlay 类型，可选 'sparse' 或 'folder'。也可使用其他值、留空或注释掉本属性
# 以禁用 overlay。将 overlay 内容放入 'minimal_overlay/rootfs' 目录，启动时
# 会自动与根文件系统合并。构建过程会创建 '/minimal.img/rootfs' 或
# '/minimal/rootfs'（见下），该目录包含全部 overlay 内容；同时还会创建
# '/minimal.img/work' 或 '/minimal/work'，由 overlay 驱动用于存放只读存储的
# 修改记录。若 overlay 介质可写，则根文件系统上的所有改动在重启后会自动保留。
#
# sparse - 使用固定最大 3MB 的稀疏文件 'minimal.img'（见 'xx_generate_overlay.sh'）。
#          生成的 ISO 镜像更大，因为稀疏文件按普通文件处理。该选项需要 root 权限，
#          否则稀疏文件生成会被静默跳过。稀疏文件作为独立磁盘镜像处理，在 FAT 上可用。
#
# folder - 使用普通目录结构（/minimal/）。注意：FAT 文件系统不支持此选项，
#          FAT 需要特殊处理（例如 POSIX overlay，见 http://sf.net/p/posixovl）。
#          该选项为默认，因为无需 root 权限。
#
OVERLAY_TYPE=folder

# 定义额外的一个或多个 overlay 软件包（bundle），构建后放置于
# 'work/overlay_rootfs' 目录，启动后即可使用。注意：大多数 overlay bundle
# 的构建依赖宿主机已安装的软件，只有默认声明的 bundle 保证可用。其余 bundle
# 的构建可能失败，因此默认未启用。你需要自行准备宿主机构建环境并安装所需
# 依赖。建议先安装 'libncurses-dev' 库，部分 overlay bundle 需要它。
#
# 未来 FasterEdgeOS 将提供功能完整的 'sysroot'，从而消除所有宿主机构建依赖。
# 但目前仍需自行维护宿主机构建环境。
#
# 注意：若使用稀疏镜像作为 overlay 结构并构建需要较多空间的软件，很可能会出
# 问题，因为 overlay 软件需要超过 3MB 的空间。解决办法是改用 folder overlay，
# 或修改脚本 'xx_generate_overlay.sh' 以生成更大尺寸的稀疏镜像。
#
# 目前可用的 overlay 软件包：
#
# all            - 全部可用的 overlay bundle。
# glibc_full     - 全部核心 GNU C 库。
#
# adopt_openjdk  - AdoptOpenJDK 提供的 JDK（HotSpot 或 OpenJ9 虚拟机）。
# bosh_cli       - BOSH CLI（命令行工具）。
# c2048          - 控制台版 2048 游戏。
# cf_cli         - Cloud Foundry CLI（命令行工具）。
# cf_tools       - 全部 BOSH 与 Cloud Foundry 工具。
# coreutils      - 常用的 GNU 可执行工具集。
# dhcp           - DHCP 与 DNS 功能。
# dialog         - 基于 ncurses 的 shell 脚本封装。
# dropbear       - SSH 服务器与客户端。
# felix          - Apache Felix OSGi 框架。
# fio            - I/O 负载生成器。
# golang         - Google 的 Go 编程语言。
# graalvm        - 支持 Java、JavaScript、Python、Ruby、R、LLVM 的虚拟机。
# kbd            - 键盘工具。
# kernel_modules - FasterEdgeOS 默认内核模块与 'mdev' 热插拔管理器。
# kexec_tools    - 从用户态加载并执行另一个内核。
# libevent       - 事件通知库。
# links          - 文本网页浏览器。
# lua            - 脚本语言。
# make           - GNU make 工具。
# mll_hello      - 简单教学用 overlay bundle，运行 'hello' 即可体验。
# mll_logo       - FasterEdgeOS 自定义启动 Logo。
# mll_nikola     - 生命的意义。
# mll_utils      - 一组可执行工具（mll-*）。
# mll_source     - FasterEdgeOS 源码，位于 '/usr/src' 目录。
# nano           - 带屏幕快捷键的简单命令行文本编辑器。
# ncurses        - 运行在终端模拟器内的 '类 GUI' API。
# nweb           - 简单的微型 HTTP 服务器。
# openjdk        - 安装 Open JDK，全部操作自动化。
# python         - Python3 脚本支持（pip 与扩展包可选）。
# screen         - GNU screen 工具，用于交互 VT100 终端。
# static_get     - Linux 便携二进制文件（见 http://s.minios.io）。
# stress         - CPU 与内存负载生成器。
# util_linux     - Linux Kernel 组织发布的实用工具。
# vim            - 高级文本编辑器。
# vitetris       - 控制台版俄罗斯方块游戏。
# zlib           - DEFLATE 压缩/解压库。
# zulujdk        - Zulu 是 OpenJDK 的认证构建，支持更完善。
#
# 更多信息请参阅 README 文件。
#
# 每个 bundle 可有独立的 '.config' 文件，用于覆盖本配置文件中的任何属性。
# 更多信息请参阅 README 文件。
#
# 以下为示例：提供 Open JDK、Apache Felix 与 Links，并由 'dhcp' 提供网络功能。
#
# OVERLAY_BUNDLES=dhcp,felix,links,openjdk
#
# 默认 overlay bundles 为：
# * dhcp
# * mll_hello
# * mll_logo
# * mll_source
#
OVERLAY_BUNDLES=dhcp,mll_hello,mll_logo,mll_source

# overlay bundle 软件的存放位置。
#
# rootfs - 所有 overlay bundle 嵌入 initramfs。启动即可用，但 initramfs 体积
#          会显著增大，FasterEdgeOS 需要更多内存才能启动。
#
# iso    - 所有 overlay bundle 打包进 ISO 镜像结构。实际存放位置取决于
#          配置属性 'OVERLAY_TYPE' 的值。
#
OVERLAY_LOCATION=iso

# 始终使用本地源码包。适用于已下载源码且无网络连接的情况，或希望分发带
# 预置源码的 FasterEdgeOS 版本。
#
USE_LOCAL_SOURCE=false

# 在屏幕左上角启用标准企鹅启动 Logo。该属性在 'xx_build_kernel.sh' 中使用，
# 默认值为 'true'（用于演示目的）。
#
USE_BOOT_LOGO=true

# 构建过程中的 make 作业数乘数。make 作业总数等于检测到的 CPU 核心数乘以本乘数。
# 例如：本属性设为 '2' 且 CPU 为 4 核时，make 作业数 = 4 * 2 = 8。
#
JOB_FACTOR=1

# 编译过程中使用的默认 GCC 标志。可自行修改，也可完全删除。
#
CFLAGS=-Os -s -fno-stack-protector -fomit-frame-pointer -U_FORTIFY_SOURCE